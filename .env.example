# Database
SUPABASE_DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require&user=postgres.your-project-ref
SUPABASE_DB_USERNAME=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-database-password

# JWT
SUPABASE_JWT_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# Application-issued JWTs for email/password accounts.
# Generate with: openssl rand -base64 48
APP_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
APP_JWT_ISSUER=reviewit-api
APP_JWT_TTL_SECONDS=86400
# BCrypt cost. 12 is recommended; tests override it to 4.
APP_BCRYPT_STRENGTH=12

# Deployment
# Frontend origins that may call the API (comma-separated, wildcards allowed).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Keep SQL logging off in production.
SPRING_JPA_SHOW_SQL=false
